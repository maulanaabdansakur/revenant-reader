# Copy to .env.local and fill in during Phase 2. Never commit real keys.
# Summarizer (task 20, decided 2026-11-11): Pollinations.ai text API —
# KEYLESS, no signup, $0. No key is needed; SUMMARIZER_API_KEY below is
# reserved for a future provider swap and is unused by Pollinations.
# Optional overrides (defaults shown):
# SUMMARIZER_BASE_URL=https://text.pollinations.ai
# SUMMARIZER_MODEL=openai
SUMMARIZER_API_KEY=
# Refresh scheduler (task 27): minutes between automatic feed polls on
# long-running servers (dev + `next start`); default 30, 0 disables the
# timer (manual refresh still works). On Vercel the timer does not fire
# reliably — deploy uses Vercel Cron (GET /api/refresh) instead.
REFRESH_INTERVAL_MINUTES=30
# Database URL for the deployed target (SQLite locally, Postgres on deploy).
DATABASE_URL=
